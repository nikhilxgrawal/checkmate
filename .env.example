# Copy this file to .env and fill in real values. .env is gitignored.

# Server
PORT=3000
ADMIN_KEY=change-me-to-a-strong-secret

# Wallet / bidding (pari-mutuel)
STARTING_BALANCE=10000
MAX_BID=0

# MySQL (run schema.sql once to create the `checkmate` database and tables)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=checkmate

# Session signing secret — set a long, random, STABLE value in production
# (e.g. `openssl rand -hex 32`). If unset, a random one is generated per boot
# and all verified logins are invalidated on every restart.
SESSION_SECRET=

# SMTP (used to send OTP + notification emails). Example shows Amazon SES.
# REQUIRED in production so users can receive login codes.
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password

# Verified sender identity for OTP emails
MAIL_FROM=no-reply@yourdomain.com

# DEV ONLY: print OTP codes to the server console and skip sending email, so you
# can log in locally without SMTP. MUST be unset/false in production.
OTP_DEV_ECHO=false

# Seeds the allowed-org list on FIRST boot (comma-separated email domains; each
# domain's first label is the org, e.g. unicommerce.com -> Unicommerce).
# Blank = any domain. After first boot the list is managed from the admin panel
# and this value no longer overrides it.
ALLOWED_EMAIL_DOMAINS=snapdeal.com

# Public base URL used in notification email links + keep-alive self-ping.
PUBLIC_URL=https://your-app-url.example.com
