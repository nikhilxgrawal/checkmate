# Copy this file to .env and fill in real values. .env is gitignored.

# Server
PORT=3000
ADMIN_KEY=change-me-to-a-strong-secret

# Session signing secret — set a long, random, STABLE value in production
# (e.g. `openssl rand -hex 32`). If unset, a random one is generated per boot
# and all verified logins are invalidated on every restart.
SESSION_SECRET=

# SMTP (used to send OTP emails). Example shows Amazon SES.
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password

# Verified sender identity for OTP emails
MAIL_FROM=no-reply@yourdomain.com

# Restrict who can verify/vote/post (comma-separated). Blank = allow any domain.
ALLOWED_EMAIL_DOMAINS=snapdeal.com
